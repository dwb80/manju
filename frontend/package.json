{
  "name": "agnes-ai-studio-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.4.2",
  "browserslist": {
    "production": [
      "Chrome >= 109",
      "Edge >= 109",
      "Firefox >= 115",
      "Safari >= 16",
      "not dead"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "dev:turbopack": "next dev --turbopack -p 3001",
    "dev:webpack": "next dev -p 3001",
    "dev:clean": "node ../scripts/clean-next-cache.mjs && next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "lint:duplicates": "node scripts/eslint-scan.mjs"
  },
