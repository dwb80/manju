{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manju.local/schemas/environment.schema.json",
  "title": "Manju runtime environment",
  "type": "object",
  "additionalProperties": true,
  "x-runtime-pass-through-prefixes": ["NEXT_", "VERCEL_", "E2E_"],
  "x-runtime-pass-through": ["LANG", "LC_ALL", "HTTP_PROXY", "HTTPS_PROXY", "PLAYWRIGHT_BROWSERS_PATH", "VERCEL"],
  "required": [
    "NODE_ENV",
    "PORT",
    "DATABASE_PATH",
    "AUTH_JWT_SECRET",
    "DATA_ENCRYPTION_KEY",
    "CORS_ALLOWED_ORIGINS"
  ],
  "properties": {
    "NODE_ENV": { "enum": ["development", "test", "staging", "production"] },
    "HOST": { "type": "string", "minLength": 1 },
    "PORT": { "type": "string", "pattern": "^[1-9][0-9]{1,4}$" },
    "DATABASE_PATH": { "type": "string", "minLength": 1 },
    "LOG_LEVEL": { "enum": ["trace", "debug", "info", "warn", "error", "fatal"] },
    "AUTH_JWT_SECRET": { "type": "string", "minLength": 32, "x-secret": true },
    "AUTH_ACCESS_TOKEN_TTL_SECONDS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "AUTH_REFRESH_TOKEN_TTL_SECONDS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "AUTH_MODE": { "enum": ["local", "sso", "hybrid"] },
    "AUTH_COOKIE_SECURE": { "enum": ["true", "false"] },
    "AUTH_ADMIN_USERNAME": { "type": "string" },
    "AUTH_ADMIN_PASSWORD": { "type": "string", "x-secret": true },
    "AUTH_ADMIN_DISPLAY_NAME": { "type": "string" },
    "AUTH_ORGANIZATION_NAME": { "type": "string" },
    "DATA_ENCRYPTION_KEY": { "type": "string", "minLength": 32, "x-secret": true },
    "DATA_ENCRYPTION_PREVIOUS_KEYS": { "type": "string", "x-secret": true },
    "INTERNAL_SERVICE_TOKENS": { "type": "string", "minLength": 16, "x-secret": true },
    "INTERNAL_SERVICE_TOKEN": { "type": "string", "minLength": 16, "x-secret": true, "deprecated": true },
    "CORS_ALLOWED_ORIGINS": { "type": "string", "minLength": 1 },
    "TRUST_PROXY": { "enum": ["true", "false"] },
    "FORCE_HTTPS": { "enum": ["true", "false"] },
    "UPLOAD_AV_REQUIRED": { "enum": ["true", "false"] },
    "CLAMAV_HOST": { "type": "string", "minLength": 1 },
    "CLAMAV_PORT": { "type": "string", "pattern": "^[1-9][0-9]{1,4}$" },
    "REMOTE_MEDIA_ALLOWED_HOSTS": { "type": "string" },
    "AGNES_BACKEND_URL": { "type": "string", "format": "uri" },
    "AGNES_API_BASE_URL": { "type": "string", "format": "uri", "deprecated": true },
    "AGNES_API_KEY": { "type": "string", "x-secret": true },
    "AGNES_TIMEOUT_OPTIMIZE_SCRIPT_MS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "CEREBRAS_API_BASE_URL": { "type": "string", "format": "uri" },
    "CEREBRAS_API_KEY": { "type": "string", "x-secret": true },
    "CEREBRAS_PROXY_URL": { "type": "string", "format": "uri" },
    "SENSENOVA_API_BASE_URL": { "type": "string", "format": "uri" },
    "SENSENOVA_API_KEY": { "type": "string", "x-secret": true },
    "SENSENOVA_PROXY_URL": { "type": "string", "format": "uri" },
    "ZHIPU_API_KEY": { "type": "string", "x-secret": true },
    "DEEPFAKE_API_KEY": { "type": "string", "x-secret": true },
    "DEEPFAKE_API_URL": { "type": "string", "format": "uri" },
    "DEEPFAKE_API_MODEL": { "type": "string" },
    "DEEPFAKE_API_TIMEOUT_MS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "DEEPFAKE_FACE_THRESHOLD": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" },
    "DEEPFAKE_SIMILARITY_THRESHOLD": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" },
    "DEEPFAKE_THRESHOLD": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$", "deprecated": true },
    "FACE_AUTH_MAX_DAYS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "FACE_FP_SECRET": { "type": "string", "x-secret": true },
    "SSO_ISSUER": { "type": "string", "format": "uri" },
    "SSO_CLIENT_ID": { "type": "string" },
    "SSO_CLIENT_SECRET": { "type": "string", "x-secret": true },
    "SSO_AUTHORIZE_URL": { "type": "string", "format": "uri" },
    "SSO_TOKEN_URL": { "type": "string", "format": "uri" },
    "SSO_USERINFO_URL": { "type": "string", "format": "uri" },
    "SSO_REDIRECT_URI": { "type": "string", "format": "uri" },
    "SSO_SCOPE": { "type": "string" },
    "SSO_AUTO_CREATE_USER": { "enum": ["true", "false"] },
    "SSO_DEFAULT_ROLE": { "type": "string" },
    "LARK_APP_ID": { "type": "string" },
    "LARK_APP_SECRET": { "type": "string", "x-secret": true },
    "FFPROBE_PATH": { "type": "string" },
    "SCRIPT_PURGE_GRACE_DAYS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "SLA_CHECK_INTERVAL_MS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "SLA_MONITOR_INTERVAL_MS": { "type": "string", "pattern": "^[1-9][0-9]*$", "deprecated": true },
    "ENDPOINT_WRITE_RATE_LIMIT": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "STRICT_PROVIDER_URLS": { "enum": ["true", "false"] },
    "SECURITY_COEP": { "type": "string" },
    "SECURITY_COOP": { "type": "string" },
    "SECURITY_CORP": { "type": "string" },
    "SECURITY_FRAME_ANCESTORS": { "type": "string" },
    "SECURITY_FRAME_OPTIONS": { "type": "string" },
    "SECURITY_PERMISSIONS_POLICY": { "type": "string" },
    "SECURITY_REFERRER_POLICY": { "type": "string" },
    "MANJU_DISABLE_OUTBOX_DISPATCHER": { "enum": ["true", "false"] },
    "BACKUP_DIR": { "type": "string" },
    "DATABASE_FILE": { "type": "string", "deprecated": true },
    "DATA_FILE": { "type": "string", "deprecated": true },
    "DB_FILE": { "type": "string", "deprecated": true },
    "DB_PATH": { "type": "string", "deprecated": true },
    "BASE_URL": { "type": "string", "format": "uri" },
    "PERFORMANCE_SMOKE_CONCURRENCY": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "PERFORMANCE_SMOKE_P95_MS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "PERFORMANCE_SMOKE_REQUESTS": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "REAL_PROVIDER_ISOLATED_ACCOUNT": { "type": "string" },
    "REAL_PROVIDER_MODEL": { "type": "string" },
    "REAL_PROVIDER_QUALITY": { "type": "string" },
    "REAL_PROVIDER_SMOKE": { "enum": ["true", "false"] },
    "NEXT_PUBLIC_API_BASE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_AGNES_BACKEND_URL": { "type": "string", "format": "uri" }
  },
  "allOf": [
    {
      "if": { "properties": { "NODE_ENV": { "const": "production" } }, "required": ["NODE_ENV"] },
      "then": {
        "required": ["FORCE_HTTPS", "UPLOAD_AV_REQUIRED", "INTERNAL_SERVICE_TOKENS"],
        "properties": {
          "FORCE_HTTPS": { "const": "true" },
          "UPLOAD_AV_REQUIRED": { "const": "true" },
          "MANJU_DISABLE_OUTBOX_DISPATCHER": { "const": "false" }
        }
      }
    }
  ]
}
